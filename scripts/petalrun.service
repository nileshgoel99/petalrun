[Unit]
Description=PetalRun Django (Gunicorn)
After=network.target

[Service]
User=root
Group=root
WorkingDirectory=/var/www/petalrun
Environment=DJANGO_DEBUG=0
Environment=DJANGO_ALLOWED_HOSTS=petalrun.fabriflow.in,localhost,127.0.0.1
Environment=DJANGO_CSRF_TRUSTED_ORIGINS=https://petalrun.fabriflow.in
Environment=DJANGO_SECRET_KEY=petalrun-prod-change-me-fleurish-2026
ExecStart=/var/www/petalrun/venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8003 --timeout 120 backend.wsgi:application
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
